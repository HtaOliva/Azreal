{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_BACKEND_URL/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://YOUR_BACKEND_URL/auth/:path*"
    },
    {
      "source": "/me",
      "destination": "https://YOUR_BACKEND_URL/me"
    },
    {
      "source": "/usuarios/:path*",
      "destination": "https://YOUR_BACKEND_URL/usuarios/:path*"
    },
    {
      "source": "/startups/:path*",
      "destination": "https://YOUR_BACKEND_URL/startups/:path*"
    },
    {
      "source": "/ambientes-validacao/:path*",
      "destination": "https://YOUR_BACKEND_URL/ambientes-validacao/:path*"
    },
    {
      "source": "/desafios/:path*",
      "destination": "https://YOUR_BACKEND_URL/desafios/:path*"
    },
    {
      "source": "/matchmaking/:path*",
      "destination": "https://YOUR_BACKEND_URL/matchmaking/:path*"
    },
    {
      "source": "/propostas-poc/:path*",
      "destination": "https://YOUR_BACKEND_URL/propostas-poc/:path*"
    },
    {
      "source": "/termos/:path*",
      "destination": "https://YOUR_BACKEND_URL/termos/:path*"
    },
    {
      "source": "/termos-piloto/:path*",
      "destination": "https://YOUR_BACKEND_URL/termos-piloto/:path*"
    },
    {
      "source": "/registros-poc/:path*",
      "destination": "https://YOUR_BACKEND_URL/registros-poc/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
